engine-strict=true
# better-sqlite3's prebuilt linux-arm64 binary is built against a newer glibc
# than Raspberry Pi OS (Bookworm, glibc 2.36) ships — installing it breaks
# every DB-backed route with a GLIBC_2.38 dlopen error. Building from source
# on-device (the Pi already has python3/make/g++) sidesteps prebuild/glibc
# drift entirely, at the cost of a slower `npm ci` (a few minutes on-device).
build-from-source=true
