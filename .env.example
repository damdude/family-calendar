# Family Calendar — environment variables
#
# Copy to `.env` and fill in real values on-device. `.env` is gitignored.
# NEVER commit real secrets. Sensitive runtime secrets (OAuth tokens, the
# device encryption secret) are generated by the setup wizard and stored
# ENCRYPTED in SQLite, not here.

# --- Server ---
# Port the dashboard/companion server listens on.
PORT=5173

# Host/interface to bind (0.0.0.0 exposes to the LAN for the phone wizard).
HOST=0.0.0.0

# --- Device encryption (Batch 4) ---
# Path to the machine id used to derive the at-rest encryption key.
# On a Pi this is /etc/machine-id; overridable for dev.
MACHINE_ID_PATH=/etc/machine-id

# --- Google Calendar OAuth (Batch 4) ---
# OAuth 2.0 *device flow* client credentials. Client secret for the device
# flow is not a true secret, but still keep real values out of Git.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Sites of Interest scraper (Batch 5) ---
# User agent used when fetching per-profile URLs (identifies the project).
SCRAPER_USER_AGENT=family-calendar/0.1 (+https://github.com/damdude/family-calendar)
